# Copy to .env and adjust. Never commit .env.
ALPHAENGINE_ENV=dev
# Local Postgres from infra/docker-compose.yml:
ALPHAENGINE_DATABASE_URL=postgresql+psycopg://alphaengine:alphaengine@localhost:5432/alphaengine
# Or zero-setup SQLite:
# ALPHAENGINE_DATABASE_URL=sqlite:///./alphaengine.db
ALPHAENGINE_DATA_DIR=./var/data
ALPHAENGINE_LOG_LEVEL=INFO
ALPHAENGINE_LOG_JSON=false
# ALPHAENGINE_TELEGRAM_BOT_TOKEN=
# ALPHAENGINE_TELEGRAM_CHAT_ID=
# ALPHAENGINE_API_KEY=
